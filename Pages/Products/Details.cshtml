@page "{id:int}"
@model ProductManagement.Web.Pages.Products.DetailsModel

@{
    ViewData["Title"] = "Product Inspection";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <a asp-page="Index" class="text-decoration-none text-secondary small fw-semibold">
                    &larr; Back to Catalog
                </a>
                <span class="badge bg-light text-dark font-monospace border rounded-pill px-3 py-2">
                    SKU: @Model.Product.Sku
                </span>
            </div>

            <div class="row g-4 align-items-center">
                <div class="col-md-5 text-center">
                    @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                    {
                        <img src="@Url.Content("~/" + Model.Product.ImageUrl)"
                             alt="@Model.Product.Title"
                             class="rounded-4 border shadow-sm img-fluid"
                             style="max-height: 280px; width: 100%; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-4 bg-light border d-flex align-items-center justify-content-center text-muted"
                             style="height: 240px;">
                            No Image Available
                        </div>
                    }
                </div>
                <div class="col-md-7">
                    <div class="d-flex gap-2 align-items-center mb-2">
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">
                            @Model.Product.Category
                        </span>
                        @if (Model.Product.Status == "Active")
                        {
                            <span class="badge bg-success-subtle text-success rounded-pill px-3">Active Listing</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">@Model.Product.Status</span>
                        }
                    </div>

                    <h2 class="fw-bold text-dark mb-2">@Model.Product.Title</h2>
                    <p class="text-secondary">@Model.Product.Description</p>

                    <div class="p-3 bg-light rounded-4 mb-4">
                        <div class="row text-center">
                            <div class="col-6 border-end">
                                <div class="text-secondary small text-uppercase fw-semibold">Unit Price</div>
                                <div class="h3 fw-bold text-primary mb-0">@Model.Product.Price.ToString("C")</div>
                            </div>
                            <div class="col-6">
                                <div class="text-secondary small text-uppercase fw-semibold">Available Units</div>
                                <div class="h3 fw-bold text-dark mb-0">@Model.Product.StockQuantity</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-page="Edit" asp-route-id="@Model.Product.Id" class="btn btn-warning rounded-pill px-4 fw-semibold">
                            Edit Item
                        </a>
                        <a asp-page="Delete" asp-route-id="@Model.Product.Id" class="btn btn-outline-danger rounded-pill px-4">
                            Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
