@page "{id:int}"
@model ProductManagement.Web.Pages.Products.EditModel

@{
    ViewData["Title"] = "Update Product";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="mb-4">
                <a asp-page="Index" class="text-decoration-none text-secondary small fw-semibold">
                    &larr; Back to Catalog Inventory
                </a>
                <h2 class="fw-bold text-dark mt-2 mb-1">Update Product Specifications</h2>
                <p class="text-secondary small">Modify item attributes, adjust pricing, or replace the product visual.</p>
            </div>

            <form method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Product.Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 py-2 px-3 small" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Product.Sku" class="form-label fw-semibold small text-uppercase"></label>
                        <input asp-for="Product.Sku" class="form-control rounded-pill px-3 font-monospace" />
                        <span asp-validation-for="Product.Sku" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Product.Title" class="form-label fw-semibold small text-uppercase"></label>
                        <input asp-for="Product.Title" class="form-control rounded-pill px-3" />
                        <span asp-validation-for="Product.Title" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Product.Category" class="form-label fw-semibold small text-uppercase"></label>
                        <select asp-for="Product.Category" class="form-select rounded-pill px-3">
                            <option value="Peripherals">Peripherals</option>
                            <option value="Audio">Audio</option>
                            <option value="Monitors">Monitors</option>
                            <option value="Components">Components</option>
                            <option value="Accessories">Accessories</option>
                            <option value="Networking">Networking</option>
                        </select>
                        <span asp-validation-for="Product.Category" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Product.Status" class="form-label fw-semibold small text-uppercase"></label>
                        <select asp-for="Product.Status" class="form-select rounded-pill px-3">
                            <option value="Active">Active Listing</option>
                            <option value="Inactive">Inactive / Suspended</option>
                            <option value="Backorder">Backorder</option>
                        </select>
                        <span asp-validation-for="Product.Status" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Product.Description" class="form-label fw-semibold small text-uppercase"></label>
                    <textarea asp-for="Product.Description" class="form-control rounded-4 p-3" rows="3"></textarea>
                    <span asp-validation-for="Product.Description" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Product.Price" class="form-label fw-semibold small text-uppercase"></label>
                        <div class="input-group">
                            <span class="input-group-text rounded-start-pill bg-light">$</span>
                            <input asp-for="Product.Price" type="number" step="0.01" min="0.01" class="form-control rounded-end-pill px-3" />
                        </div>
                        <span asp-validation-for="Product.Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Product.StockQuantity" class="form-label fw-semibold small text-uppercase"></label>
                        <input asp-for="Product.StockQuantity" type="number" min="0" class="form-control rounded-pill px-3" />
                        <span asp-validation-for="Product.StockQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="p-3 bg-light rounded-4 mb-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                        {
                            <img src="@Url.Content("~/" + Model.Product.ImageUrl)"
                                 alt="@Model.Product.Title"
                                 class="rounded-3 border shadow-xs"
                                 style="width: 80px; height: 80px; object-fit: cover;" />
                        }
                        <div>
                            <div class="fw-semibold text-dark small text-uppercase">Existing Image Asset</div>
                            <div class="text-muted small">@Model.Product.ImageUrl</div>
                        </div>
                    </div>
                    <label asp-for="ReplacementImage" class="form-label fw-semibold small text-uppercase">Replace Visual (Optional)</label>
                    <input asp-for="ReplacementImage" type="file" accept=".jpg,.jpeg,.png,.webp,.svg" class="form-control rounded-pill px-3 bg-white" />
                    <span asp-validation-for="ReplacementImage" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 pt-2 border-top">
                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-semibold">
                        Save Changes
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
