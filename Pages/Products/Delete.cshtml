@page "{id:int}"
@model ProductManagement.Web.Pages.Products.DeleteModel

@{
    ViewData["Title"] = "Decommission Product";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 border-top border-danger border-4">
            <h3 class="fw-bold text-danger mb-2">Confirm Product Decommission</h3>
            <p class="text-secondary small">
                Are you sure you want to permanently delete this product from the inventory database? Associated visual assets will be unlinked and purged.
            </p>

            <div class="p-3 bg-light rounded-4 my-3 d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                {
                    <img src="@Url.Content("~/" + Model.Product.ImageUrl)"
                         alt="@Model.Product.Title"
                         class="rounded-3 border shadow-xs"
                         style="width: 70px; height: 70px; object-fit: cover;" />
                }
                <div>
                    <span class="badge bg-light text-dark font-monospace border rounded-pill px-2 py-1 mb-1">
                        @Model.Product.Sku
                    </span>
                    <h5 class="fw-bold mb-1 text-dark">@Model.Product.Title</h5>
                    <div class="text-secondary small">
                        <strong>Valuation:</strong> @Model.Product.Price.ToString("C") &bull; <strong>Stock:</strong> @Model.Product.StockQuantity units
                    </div>
                </div>
            </div>

            <form method="post">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                        Confirm Permanent Delete
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
