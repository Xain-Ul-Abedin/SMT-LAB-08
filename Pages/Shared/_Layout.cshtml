<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise PMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProductManagement.Web.styles.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Lexend', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
        }
        .navbar-brand {
            letter-spacing: -0.02em;
        }
        .card {
            border: 1px solid rgba(226, 232, 240, 0.8) !important;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top bg-white border-bottom shadow-xs">
        <nav class="navbar navbar-expand-lg navbar-light py-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-dark d-flex align-items-center gap-2" asp-page="/Products/Index">
                    <span class="badge bg-dark rounded-circle p-2 fs-6">P</span>
                    <span>ENTERPRISE<span class="text-primary fw-normal">.PMS</span></span>
                </a>
                <button class="navbar-toggler rounded-pill border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-dark px-3" asp-page="/Products/Index">Product Inventory</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary px-3" asp-page="/Index">Overview</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-page="/Products/Create" class="btn btn-outline-dark rounded-pill px-4 btn-sm fw-semibold">
                            + New Item
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3 bg-white border-top">
        <div class="container d-flex flex-wrap justify-content-between align-items-center text-muted small">
            <div>
                &copy; 2026 Enterprise Product Management System &bull; SMT Lab 08
            </div>
            <div>
                Built with ASP.NET Core &amp; Decoupled Repository Pattern
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
